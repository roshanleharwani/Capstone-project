# Copy to .env and fill in real values. Never commit .env.
# PowerShell:  Copy-Item .env.example .env
# Then:        $env:OPENAI_API_KEY = (Get-Content .env | Where-Object { $_ -match '^OPENAI_API_KEY=' }) -replace '^OPENAI_API_KEY=',''

# Required for Tier-2 OpenAI routing (router-dashboard / nexus-proxy)
OPENAI_API_KEY=

# Optional local dashboard → gateway wiring
GATEWAY_URL=http://127.0.0.1:8081
GATEWAY_API_KEY=sk-nexus-test-key-12345
NEXT_PUBLIC_PROXY_URL=http://127.0.0.1:8081
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8081

# Local stateful defaults (dev only — override in real deploys)
POSTGRES_PASSWORD=nexus_secret
REDIS_PASSWORD=valkey_secret
